[Unit]
Description=iii Caller Worker (TypeScript)
After=network.target

[Service]
Type=simple
User=skpc
WorkingDirectory=/home/skpc/hiring/may-2026/devops/quickstart/workers/caller-worker
Environment="PATH=/home/skpc/.local/bin:/usr/local/bin:/usr/bin:/bin"
Environment="III_URL=ws://localhost:49134"
ExecStart=/usr/bin/node --import tsx/esm src/worker.ts
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target